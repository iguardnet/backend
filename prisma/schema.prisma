datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // previewFeatures = []
}

generator dbml {
  provider = "prisma-dbml-generator"
}

enum Role {
  ADMIN
  USER
}

enum SignInProvider {
  ANONYMOUS @map("anonymous")
  GOOGLE    @map("google.com")
  PASSWORD  @map("password")
}

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  password       String?         @db.VarChar(255)
  name           String?         @db.VarChar(255)
  role           Role            @default(USER)
  phone          String?         @unique @db.VarChar(255)
  firebaseId     String?         @unique @db.VarChar(255)
  email          String?         @unique @db.VarChar(255)
  deviceId       String?         @db.VarChar(255)
  signInProvider SignInProvider?
  emailVerified  Boolean?

  ClientStat             ClientStat[]
  GoogleSubscription GoogleSubscription[]
}

// android
// {
//   "dailyTrafficLimit": "1.2.1",
//   "currentVersion": "1.2.1",
//   "foreUpdateVersion": "1.1.0"
// }
model ClientInfo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  android      Json?
  ios          Json?
  subscription Json?
}

model File {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @db.Uuid
  name      String   @db.VarChar(255)

  @@index([userId], name: "FileUserIdIndex")
}

enum ServerCountry {
  IR
  NL
  DE
  TR
  FI
  US
  SG
}

model Server {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  type         ServerCountry
  ip           String        @db.VarChar(255)
  domain       String        @db.VarChar(255)
  inboundId    Int           @default(1)
  token        String
  tunnelDomain String        @db.VarChar(255)
  stats        Json?
  isPremium    Boolean       @default(true)

  clientStat ClientStat[]
}

model ClientStat {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  serverId        String    @db.Uuid
  userId          String    @db.Uuid
  lastTotalUsage  BigInt?
  lastConnectedAt DateTime?
  expiryTime      BigInt
  total           BigInt
  down            BigInt
  up              BigInt
  email           String    @db.VarChar(255)
  enable          Boolean
  flow            String    @db.VarChar(255)
  subId           String    @db.VarChar(255)
  tgId            String    @db.VarChar(255)
  limitIp         Int

  user   User   @relation(fields: [userId], references: [id])
  server Server @relation(fields: [serverId], references: [id])

  @@index([serverId], name: "ClientStatServerIdIndex")
  @@index([userId], name: "ClientStatUserIdIndex")
  @@index([expiryTime], name: "ClientStatExpiryTimeIndex")
  @@index([total], name: "ClientStatTotalIndex")
  @@index([down], name: "ClientStatDownIndex")
  @@index([up], name: "ClientStatUpIndex")
  @@index([deletedAt], name: "ClientDeletedAtIndex")
}

