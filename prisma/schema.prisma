model GoogleSubscription {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  userId                      String    @db.Uuid
  purchaseToken               String
  packageName                 String    @db.VarChar(255)
  subscriptionId              String    @db.VarChar(255)
  kind                        String    @db.VarChar(255)
  startTimeMillis             DateTime
  expiryTimeMillis            DateTime
  autoResumeTimeMillis        DateTime?
  autoRenewing                Boolean
  priceCurrencyCode           String    @db.VarChar(255)
  priceAmountMicros           BigInt
  countryCode                 String    @db.VarChar(255)
  developerPayload            String
  paymentState                Int?
  cancelReason                Int?
  userCancellationTimeMillis  DateTime?
  orderId                     String    @db.VarChar(255) @unique 
  linkedPurchaseToken         String?
  purchaseType                Int?
  profileName                 String?   @db.VarChar(255)
  emailAddress                String?   @db.VarChar(255)
  givenName                   String?   @db.VarChar(255)
  familyName                  String?   @db.VarChar(255)
  profileId                   String?   @db.VarChar(255)
  acknowledgementState        Int
  externalAccountId           String?   @db.VarChar(255)
  promotionType               Int?
  promotionCode               String?   @db.VarChar(255)
  obfuscatedExternalAccountId String?   @db.VarChar(255)
  obfuscatedExternalProfileId String?   @db.VarChar(255)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], name: "GoogleSubscriptionUserIdIndex")
  @@index([expiryTimeMillis], name: "GoogleSubscriptionExpiryTimeMillisIndex")
  @@index([paymentState, cancelReason, expiryTimeMillis], name: "GoogleSubscriptionCompositeIndex")
}


